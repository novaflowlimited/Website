# Novaflow environment template
# Copy to `.env` and fill in real values. Never commit real secrets.

# --- Runtime ---
NODE_ENV=development
PORT=8787

# --- Database (SECRET) ---
DATABASE_URL=postgresql://novaflow:novaflow@localhost:5435/novaflow

# --- Auth (SECRET) ---
# Required in production. Must be >= 32 chars and not a known default.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Cookie Secure flag override (optional). Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true

# --- CORS (SERVER) ---
# Comma-separated browser origins allowed to call the API with credentials.
# Required in production.
CORS_ORIGINS=http://localhost:4321,http://localhost:5173

# --- Public website / CMS URLs (PUBLIC) ---
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_API_URL=http://localhost:8787
PUBLIC_CMS_URL=http://localhost:5173
CMS_URL=http://localhost:5173
VITE_API_URL=http://localhost:8787
VITE_WEBSITE_URL=http://localhost:4321

# --- Object storage / R2 (SECRET except public URL) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=novaflow-media
# R2_PUBLIC_URL=https://media.example.com

# --- Webhooks (SECRET) ---
# REBUILD_WEBHOOK_URL=
# REBUILD_WEBHOOK_SECRET=
# ENQUIRY_NOTIFY_WEBHOOK=
# ENQUIRY_NOTIFY_WEBHOOK_SECRET=
# ENQUIRY_NOTIFY_EMAIL=

# --- Seed (development / controlled bootstrap only) ---
# ALLOW_PRODUCTION_SEED=false
# SEED_ADMIN_PASSWORD=
# SEED_EDITOR_PASSWORD=
