{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@novaflow/types": ["./packages/types/src/index.ts"],
      "@novaflow/validation": ["./packages/validation/src/index.ts"],
      "@novaflow/config": ["./packages/config/src/index.ts"],
      "@novaflow/ui": ["./packages/ui/src/index.ts"],
      "@novaflow/database": ["./packages/database/src/index.ts"]
    }
  }
}
